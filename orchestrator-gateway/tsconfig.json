{
  "compilerOptions": {
    "target":            "ES2022",
    "module":            "CommonJS",
    "moduleResolution":  "node",
    "outDir":            "./dist",
    "rootDir":           "./src",
    "esModuleInterop":   true,
    "skipLibCheck":      true,
    "strict":            false,
    "declaration":       true
  },
  "include": ["src/**/*"]
}
