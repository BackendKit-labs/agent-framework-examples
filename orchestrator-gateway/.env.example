GATEWAY_PORT=3400

# ── Orchestrator connection (choose one mode) ─────────────────────────────────
# HTTP mode (production): orchestrator runs as an independent service
# ORCHESTRATOR_HTTP_URL=http://localhost:3500

# Stdio mode (local dev): gateway spawns the orchestrator as a child process
# ORCHESTRATOR_SERVER=../../../backendkit-agents/packages/orchestrator-mcp-agent/dist/server.js
# ORCHESTRATOR_CONFIG=../../workflow.mcp-agents/orchestrator-mcp.yaml

# Agent ports (must match the running agents)
TRIAGE_PORT=3301
FORMATTER_PORT=3302
CURATOR_PORT=3200
SYNTHESIZER_PORT=3303

# Vault + auth
VAULT_PATH=
CURATOR_HTTP_API_KEY=
