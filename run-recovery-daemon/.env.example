LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Absolute path to the orchestrator data dir (contains runs/*.json)
ORCHESTRATOR_DATA_DIR=C:\path\to\workflow.mcp-agents\.orchestrator-mcp-data

# Path to orchestrator-mcp.yaml (used when spawning orchestrator for retry)
ORCHESTRATOR_CONFIG=C:\path\to\workflow.mcp-agents\orchestrator-mcp.yaml

# Working dir when spawning the orchestrator (usually same as the yaml dir)
ORCHESTRATOR_CWD=C:\path\to\workflow.mcp-agents

# Override if orchestrator-mcp-agent is installed locally
# ORCHESTRATOR_CMD=node node_modules/.bin/orchestrator-mcp-agent

# Agent base URLs (for health checks)
CURATOR_URL=http://localhost:3200
TRIAGE_URL=http://localhost:3301
SYNTHESIZER_URL=http://localhost:3303
FORMATTER_URL=http://localhost:3302

# Webhook port for external event triggers
WEBHOOK_PORT=3401
