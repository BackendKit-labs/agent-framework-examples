# Ports for test agents
TRIAGE_PORT=3301
FORMATTER_PORT=3302

# Curator-codex HTTP server (must be running separately)
CURATOR_PORT=3200

# Vault path for curator-codex RAG search
# Set this to your vault directory
VAULT_PATH=/path/to/your/vault

# Optional: shared API key for agent authentication
# AGENT_API_KEY=sk-local-test

# Curator-codex API key (if CURATOR_API_KEY is set on that server)
# CURATOR_API_KEY=

# LLM provider for curator-codex (only needed if curator does synthesis)
DEEPSEEK_API_KEY=
