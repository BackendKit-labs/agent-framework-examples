# ============================================================
# Stage 1: Build smart-money-mcp-v2 (spawned at runtime by the agent engine)
# ============================================================
FROM node:20-alpine AS mcp-builder
WORKDIR /mcp
COPY mcp-servers/smart-money-mcp-v2/package*.json ./
RUN npm install --legacy-peer-deps
COPY mcp-servers/smart-money-mcp-v2 .
RUN npm run build

# ============================================================
# Stage 2: Backend dependencies (cached layer)
# ============================================================
FROM node:20-alpine AS deps
WORKDIR /app
RUN apk add --no-cache python3 make g++
COPY backend/package*.json ./
RUN npm install --legacy-peer-deps && npm cache clean --force

# ============================================================
# Stage 3: Build backend
# ============================================================
FROM node:20-alpine AS builder
WORKDIR /app
RUN apk add --no-cache python3 make g++
COPY --from=deps /app/node_modules ./node_modules
COPY backend/. .
RUN npm run build

# ============================================================
# Stage 4: Production runner (minimal)
# ============================================================
FROM node:20-alpine AS runner
WORKDIR /app
RUN apk add --no-cache tini
COPY --from=deps /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package.json ./
# Copy MCP server so the agent engine can spawn it via child_process
COPY --from=mcp-builder /mcp/dist ./mcp-servers/smart-money-mcp-v2/dist

EXPOSE 3000
USER node
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/main.js"]
