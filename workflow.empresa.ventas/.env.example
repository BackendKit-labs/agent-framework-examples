# Copiar a .env y completar los valores

DEEPSEEK_API_KEY=sk-...

# Opcional: habilitar HTTP trigger para integración con n8n o sistemas externos
# ORCHESTRATOR_HTTP_PORT=3000
# ORCHESTRATOR_CONFIG=/ruta/absoluta/a/orchestrator.yaml
# ORCHESTRATOR_API_KEY=clave-secreta

# Opcional: usar Redis para estado distribuido (múltiples instancias / workers)
# ORCHESTRATOR_REDIS_URL=redis://localhost:6379
